# Copy to .env and fill in. Load with:  set -a; source .env; set +a   (then mvn spring-boot:run)

# ── GitLab ────────────────────────────────────────────────────────────────────
# For the host app talking to GitLab CE from docker-compose, use the host-mapped URL:
GITLAB_URL=http://localhost:8080
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx        # project/personal access token, 'api' scope
GITLAB_WEBHOOK_SECRET=demo-secret              # must match the secret you set on the webhook

# ── Database (matches docker-compose defaults) ────────────────────────────────
DB_HOST=localhost
DB_USER=reviewer
DB_PASS=reviewer

# ── LLM provider ──────────────────────────────────────────────────────────────
# AI_PROVIDER selects the active chat model: anthropic | openai
# (both starters are on the classpath; the other one is disabled at startup).

# (a) Anthropic / Claude — default. Native integration.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
AI_MODEL=claude-haiku-4-5                       # fast + cheap; use claude-sonnet-4-6 for higher quality

# (b) OpenAI-compatible (OpenAI, OpenRouter, or a local/host Ollama). Uncomment to use.
# AI_PROVIDER=openai
# AI_BASE_URL=https://openrouter.ai/api         # or https://api.openai.com, or http://localhost:11434 for Ollama
# AI_MODEL=google/gemini-2.0-flash-001          # or gpt-4o-mini, or qwen2.5-coder for Ollama
# OPENAI_API_KEY=sk-or-xxxxxxxxxxxxxxxx          # any non-empty value for Ollama

# ── Reviewer tuning (optional) ────────────────────────────────────────────────
MIN_SEVERITY=Low
